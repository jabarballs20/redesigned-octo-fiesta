{
  "name": "G2Leafy Codespace",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "G2Leafy Panel",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "PANEL_PORT": "8080",
    "XRAY_ENABLED": "0"
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "bash -lc 'pkill -f \"node backend.js\" || true; mkdir -p data/xray; nohup npm start > /tmp/g2leafy.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
