{
  "name": "G2Leafy Codespace",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "G2Leafy Panel",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "PANEL_PORT": "8080",
    "XRAY_ENABLED": "1"
  },
  "postCreateCommand": "npm install && npm install -g nodemon",
  "postStartCommand": "bash -lc 'mkdir -p data/xray; nohup nodemon --watch backend.js backend.js > /tmp/g2leafy.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-vscode-remote.remote-containers"
      ]
    }
  }
}
